{
  "name": "use-wasm-state",
  "version": "0.0.0",
  "description": "React state that lives in a WebAssembly engine written in Go. A datagrid whose sort, filter and search run in wasm, on the main thread or in a worker; only the rows on screen cross to JS.",
  "keywords": [
    "react",
    "wasm",
    "webassembly",
    "state",
    "datagrid",
    "data-grid",
    "web-worker",
    "typescript",
    "tinygo"
  ],
  "license": "MIT",
  "author": "Kez Anwar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kezanwar/use-wasm-state.git"
  },
  "homepage": "https://kezanwar.github.io/use-wasm-state/",
  "bugs": {
    "url": "https://github.com/Kezanwar/use-wasm-state/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "datagrid": [
        "./dist/datagrid.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./datagrid": {
      "import": {
        "types": "./dist/datagrid.d.ts",
        "default": "./dist/datagrid.js"
      },
      "require": {
        "types": "./dist/datagrid.d.cts",
        "default": "./dist/datagrid.cjs"
      }
    },
    "./datagrid.wasm": "./dist/datagrid.wasm",
    "./datagrid.worker.js": "./dist/datagrid.worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/datagrid.worker.cjs",
    "llm.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm build && pnpm --filter use-wasm-state-demo dev",
    "build": "tsup",
    "build:wasm": "node scripts/build-wasm.mjs",
    "inspect:wasm": "node scripts/inspect-wasm.mjs src/datagrid/datagrid.wasm --expect-exports-from scripts/engine-exports.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter use-wasm-state-demo exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:go": "cd engine && go test ./...",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build && pnpm test",
    "bench": "node --expose-gc scripts/benchmark.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wabt": "^1.0.36"
  }
}
