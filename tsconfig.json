{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "use-wasm-state": ["./src/index.ts"],
      "use-wasm-state/datagrid": ["./src/datagrid/index.ts"],
      "@/*": ["./examples/react-demo/src/*"],
      "react-router": ["./examples/react-demo/node_modules/react-router"]
    }
  },
  "include": [
    "src",
    "test",
    "e2e",
    "scripts/engine-exports.d.mts",
    "scripts/bench-entry.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
